# Fitxers de bloqueig temporals de Word/Excel (apareixen quan el fitxer
# esta obert; desapareixen en tancar-lo). Mai s'han de versionar.
~$*

# Copies de seguretat que fa l'editor de catalegs en desar (REQ1.json.bak...).
# Son locals: el que es puja es el .json bo. Sense aquesta regla, l'Actualitzar.bat
# se'ls enduria en fer 'git add ESTRUCTURALS'.
ESTRUCTURALS/*.bak

# Cache de miniatures del Windows Explorer.
Thumbs.db
ehthumbs.db
Desktop.ini

# Carpetes locals d'informes generats (fallback quan la I: no es accessible).
Informes generats/

# Mapes de ruta generats pel planificador (Ruta.bat). Son HTML locals que
# l'usuari imprimeix a PDF; no s'han de versionar.
Rutes generades/

# Base de dades d'activitats LOCAL (fallback per a us fora de la feina).
# La carpeta es mante al repo (amb un README.txt); els .xls/.xlsx de
# dins NO es pugen.
BASE DE DADES ACTIVITATS/*.xls
BASE DE DADES ACTIVITATS/*.xlsx

# Base de dades d'informes generada per l'escaner del menu (informes-db.json).
# Es local (surt d'informes que poden contenir dades personals): NO es puja.
BASE DE DADES ACTIVITATS/*.json

# Registre local d'activitats extraordinaries (mode ACT_EXTR). Conte dades
# personals (titulars, adreces): NO s'ha de pujar mai al GitHub public. La
# carpeta es mante al repo (amb un README.txt); el .json de dins NO es puja.
BASE DE DADES ACT_EXTR/*.json
